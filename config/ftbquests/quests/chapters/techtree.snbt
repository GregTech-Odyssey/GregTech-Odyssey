{
	autofocus_id: "112FC03136F231BC"
	default_hide_dependency_lines: false
	default_quest_shape: "circle"
	filename: "techtree"
	group: ""
	id: "4E2C959E286891F5"
	order_index: 8
	quest_links: [ ]
	quests: [
		{
			description: [
				"科技树是新的扫描研究系统：扫描物品或流体得到研究点数，研究点数先写入数据晶片，再由基元扫描站转化为团队共有的研究点数。"
				"数据中心检查团队研究点数并积累算力来推进科技节点；节点解锁后，才能导出对应的配方数据或获得全局效果。"
				"本章按从左到右的流程介绍：扫描 → 晶片 → 研究点数 → 科技节点 → 数据导出。"
			]
			id: "112FC03136F231BC"
			shape: "hexagon"
			size: 2.0d
			tasks: [{
				id: "0BB2386D37AE134A"
				item: "gtceu:iv_scanner"
				type: "item"
			}]
			title: "科技树总览"
			x: -8.0d
			y: -4.0d
		}
		{
			description: [
				"旧流程是：扫描仪/研究站消耗算力 → 闪存等介质 → 数据库 → 配方。"
				"新流程拆成两个阶段：扫描仪只负责把对象写成研究点数晶片；数据中心再检查团队研究点数并积累算力来解锁科技节点。"
				"尤里卡不是必需条件，但扫描指定对象可以降低对应节点所需的算力，前期节点甚至可以完全免算力解锁。"
			]
			id: "68213A518B1BAE4E"
			shape: "pentagon"
			size: 2.0d
			tasks: [{
				id: "39B5E85ADFF1F7F1"
				type: "checkmark"
			}]
			title: "新旧流程对照"
			x: -8.0d
			y: 6.0d
		}
		{
			dependencies: ["112FC03136F231BC"]
			description: [
				"扫描仪的输入是一个可扫描对象和一张有足够剩余空间的数据晶片，输出是写入研究点数的晶片。"
				"扫描时间为简单/普通/专家难度的10/20/30秒；基础耗能为本次研究点数总字节数 × 8 + 8 EU/t，并支持超频。"
				"物品、流体和同一材料的不同形态会共用扫描记录；重复扫描会按难度将收益降低到25%、6.25%或1.5625%。"
			]
			id: "5D182610DA157E66"
			shape: "hexagon"
			size: 2.0d
			tasks: [{
				id: "3C49D75824DE57B1"
				item: "gtceu:iv_scanner"
				type: "item"
			}]
			title: "扫描仪革新"
			x: -1.0d
			y: -4.0d
		}
		{
			dependencies: ["5D182610DA157E66"]
			description: [
				"扫描目标的配方可以在 EMI 的“数据扫描”分类中查看。"
				"左侧放入待扫描的物品或流体，右侧放入能装下本次全部研究点数的数据晶片；容量不足时配方不会运行。"
				"扫描完成时，如果目标是某个科技节点的尤里卡对象，会同时记录尤里卡。"
			]
			id: "2E41B9522F285629"
			shape: "circle"
			size: 2.0d
			tasks: [{
				id: "5F2396D13071A546"
				title: "完成一次数据扫描"
				type: "checkmark"
			}]
			x: 2.0d
			y: -7.0d
		}
		{
			dependencies: ["5D182610DA157E66"]
			description: [
				"数据晶片按等级提供存储空间：1级为4 kB，之后每升一级容量提高32倍。"
				"每种研究点数标签（ResearchTag）的单点字节数不同，例如材料16 B、数据存储64 B、计算/能源/热力学/组装128 B、精灵/催化256 B；更高阶标签会占用更多空间。"
				"在 EMI 搜索研究点数可以查看标签的显示名、每点占用空间以及一张晶片的总占用。"
			]
			id: "33FA6B01196B104F"
			shape: "circle"
			size: 2.0d
			tasks: [{
				id: "71A0E449AA1D0148"
				item: "gtocore:data_crystal_mk1"
				type: "item"
			}]
			title: "数据晶片与容量"
			x: -2.0d
			y: -9.0d
		}
		{
			dependencies: [
				"2F45AE4F20001FD8"
				"6E72DDA534829D02"
			]
			description: [
				"扫描数据不会直接成为科技节点的解锁材料。"
				"将装有研究点数的数据晶片放入基元扫描站，扫描站会把其中的数据解析为团队共享的研究点数；晶片内有多少数据不影响单张晶片的固定解析耗时与耗能。"
				"只有进入团队总量后，数据中心才会检查这些研究点数是否满足科技节点需求。"
			]
			id: "71AB0F7023FDC914"
			shape: "hexagon"
			size: 2.0d
			tasks: [{
				id: "49397A466CD2E349"
				item: "gtocore:dataunit_scanning_station"
				type: "item"
			}]
			title: "解析数据晶片"
			x: 12.0d
			y: -7.0d
		}
		{
			dependencies: ["5D182610DA157E66"]
			description: [
				"同一材料的板、锭、流体等形态会被视为同一种扫描对象。"
				"同一对象重复扫描时，扫描记录与材料记录不会重复增加；收益会按扫描难度衰减，因此应优先扫描尚未学习的对象。"
				"扫描目标是否能触发尤里卡，也可以在 EMI 的科技节点页面中反查。"
			]
			id: "0A4FD8FD32FBC0EF"
			shape: "pentagon"
			size: 2.0d
			tasks: [{
				id: "0B56270E53E94060"
				title: "理解扫描记录与重复惩罚"
				type: "checkmark"
			}]
			x: -4.0d
			y: -7.0d
		}
		{
			dependencies: ["094AF354546B3C55"]
			description: [
				"扫描材料或使用专用机器都可以获得对应领域的研究点数标签。"
				"当前主要来源：精灵来自魔法材料扫描；组装来自可由组装机、太空组装或装配线处理的材料；计算来自扫描或计算数据支架；生物来自生物研究太空舱；催化来自催化材料或催化数据支架。"
				"星际工程来自解锁星球的数据，也可由太空电梯工程信息模块提供；数据存储、能源、热力学和光学分别有对应的数据形态测试厂、能源数据支架、热力学分析平台和激光计算测试平台。"
			]
			id: "0A2271687C48AFD3"
			shape: "pentagon"
			size: 2.0d
			tasks: [{
				id: "4B160D4AABC54651"
				title: "认识各领域的研究点数来源"
				type: "checkmark"
			}]
			x: 8.0d
			y: -1.0d
		}
		{
			description: [
				"&6&l材料研究点数&r"
				"&e每点占用：&r16 B，是晶片中最紧凑的研究点数标签。"
				"扫描任何能识别为 GT 材料的物品或流体会得到32点；同一材料的不同形态共用扫描记录与重复扫描惩罚。"
				"这是大量组件、加工与材料科技节点的基础消耗。"
			]
			hide_dependency_lines: true
			id: "0F425AE27FF0C27D"
			shape: "circle"
			size: 2.0d
			tasks: [{
				id: "4F35D2914A9EBB6B"
